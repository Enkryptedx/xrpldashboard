#~ msgid ""
#~ "There is no central company in "
#~ "charge of the notebook. Instead, a "
#~ "network of independent computers around "
#~ "the world — called <em>validators</em> —"
#~ " propose what the next page should"
#~ " say. They are run by universities,"
#~ " exchanges, banks, the XRP Ledger "
#~ "Foundation, and ordinary technically-inclined"
#~ " people in different countries. At "
#~ "any given moment, around 150+ validator"
#~ " servers publish proposals on the "
#~ "network, but consensus is built on "
#~ "a smaller, trusted set — currently "
#~ "around 35 validators on the default "
#~ "<em>unique node list</em> maintained by "
#~ "the XRP Ledger Foundation. Any operator"
#~ " can publish their own trusted set"
#~ " if they don't want to use the"
#~ " default."
#~ msgstr ""

