# Python
__pycache__/
*.pyc
*.pyo

# Virtual envs
venv/
.venv/
venv_py311/
venv_py312/

# launchd runtime state — timestamp files written by launchd jobs on success.
# Same class as amm_index.json etc: generated, not source of truth.
launchd_state/

# Parked/deferred work — kept on disk for possible revisit, not shipped.
parked/

# Env / secrets
.env
.env.local
# launchd plist for the XRPL stream worker carries DATABASE_URL inline.
# Other plists in launchd/ (daily_snapshot, verify_toml) have no secrets
# and are tracked.
launchd/com.charliebruce.xrpldashboard.xrpl_stream.plist

# Logs
*.log

# Local cache / scan output (prophylactic — none currently in repo)
amm_pools.json
*.cache.json
scan_output/
data/

# Signed snapshots — generated by launchd, served from PG; disk copies are local only
signed_snapshots/
# Ed25519 encrypted private key — never commit
snapshot_ed25519_enc.pem

# Generated prev/backup files
*.prev

# Generated outputs (daily posts, historical snapshots, translation scripts)
daily_posts/
historical_snapshots/
translate_all.py
translate_complete.py
apply_prose.py
daily_twitter_post.py
mpt_snapshot.v3sandbox.json

# Backup templates
templates/*_v1.html
templates/*_backup.html

# Runtime state — generated, not source of truth
amm_index.json
amm_index_incremental.json
amm_scan_state.json
xrpl_stream_state.json
amm_rank_state.json
amm_ranked.json
lending_snapshot.json
mpt_snapshot.json
mpt_issuance_list.json

# DBs
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Private partner call notes
partner_conversations.md

# Outreach log contains PII (real names, emails, reply notes) — keep local
OUTREACH_LOG.md

# Attorney / legal work product — structural block so a stray `git add`
# cannot ride a future commit. Class-level rule, not per-file — any doc
# whose name signals privileged content is blocked wherever it lands
# (repo root or docs/). The single ATTORNEY_BRIEF_2026-08-10.md that
# prompted this rule lives outside the repo at
# ~/.openclaw/workspace/private/ATTORNEY_BRIEF_2026-08-10.md (0700 dir).
# Rule codified 2026-08-10 after JJ caught it by judgment during a
# ship — belt-and-suspenders: judgment + gitignore.
**/ATTORNEY_*
**/*_ATTORNEY_*
**/*ATTORNEY*
**/PRIVILEGED_*
**/*_PRIVILEGED_*
**/*_LEGAL_*
**/*_COUNSEL_*

# Private archives: user-submitted content from dead tables, contact-form
# exports, anything with rows that came from third parties. DDL/schema
# archives go in migrations/archived/ (repo); row data lands here (local).
# Rule codified 2026-07-08 during feedback-table orphan drop.
_private/

# Scratch space — investigation output, one-off scripts, JSON dumps.
# Was untracked-but-unignored, meaning a git add . would sweep it in.
scratch/

# Local ad-hoc analysis outputs (JSON dumps, incident state snapshots,
# fixture drafts) — same rule as scratch/, distinct location for cleanliness.
artifacts/
# Rippled rebuild run logs — large per-incident, kept locally for postmortem.
ops/rebuild_runs/
# Legacy walker-watch tooling — dormant since 2026-06-12, kept locally only.
ops/goose/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
