# Python
__pycache__/
*.pyc
*.pyo

# Virtual envs
venv/
.venv/

# Env / secrets
.env
.env.local
# launchd plist for the XRPL stream worker carries DATABASE_URL inline.
# Other plists in launchd/ (daily_snapshot, verify_toml) have no secrets
# and are tracked.
launchd/com.charliebruce.xrpldashboard.xrpl_stream.plist

# Logs
*.log

# Local cache / scan output (prophylactic — none currently in repo)
amm_pools.json
*.cache.json
scan_output/
data/

# Signed snapshots — generated by launchd, served from PG; disk copies are local only
signed_snapshots/
# Ed25519 encrypted private key — never commit
snapshot_ed25519_enc.pem

# Generated prev/backup files
*.prev

# Generated outputs (daily posts, historical snapshots, translation scripts)
daily_posts/
historical_snapshots/
translate_all.py
translate_complete.py
apply_prose.py
daily_twitter_post.py
mpt_snapshot.v3sandbox.json

# Backup templates
templates/*_v1.html
templates/*_backup.html

# Runtime state — generated, not source of truth
amm_index.json
amm_index_incremental.json
amm_scan_state.json
xrpl_stream_state.json
amm_rank_state.json
amm_ranked.json
lending_snapshot.json
mpt_snapshot.json
mpt_issuance_list.json

# DBs
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Private partner call notes
partner_conversations.md

# Outreach log contains PII (real names, emails, reply notes) — keep local
OUTREACH_LOG.md

# Private archives: user-submitted content from dead tables, contact-form
# exports, anything with rows that came from third parties. DDL/schema
# archives go in migrations/archived/ (repo); row data lands here (local).
# Rule codified 2026-07-08 during feedback-table orphan drop.
_private/

# Scratch space — investigation output, one-off scripts, JSON dumps.
# Was untracked-but-unignored, meaning a git add . would sweep it in.
scratch/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
