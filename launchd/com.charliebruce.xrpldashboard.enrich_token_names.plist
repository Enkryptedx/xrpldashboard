<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.enrich_token_names</string>

    <key>Comment</key>
    <string>Weekly token name enrichment: MPT on-ledger metadata + IOU issuer TOML lookup → token_names.json.</string>

    <!-- Wrapper sources ~/.config/xrpldashboard/env before invoking
         python. Calling python directly leaves DATABASE_URL unset —
         both walker_health and token_names writes silently no-op.
         Caught by plist sweep 2026-07-08 alongside lending_snapshot +
         verify_toml. See run_enrich_token_names.sh. -->
    <key>ProgramArguments</key>
    <array>
      <string>/Users/charliebruce/xrpl_test/launchd/run_enrich_token_names.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <!-- Weekly cadence, calendar-anchored to Wed 08:00 local (was
         StartInterval=604800 until 2026-08-29). Anchored day = Wed to
         land 1 day after verify_toml's Tue run so any new TOML-attested
         accounts are in named_accounts.json before we run the IOU TOML
         currency lookup pass.
         Reason for switch: StartInterval counts from launchctl load
         moment; two power events (2026-08-13 + 2026-08-20) reset the
         counter and drifted the next-fire out to 2026-08-27, then
         re-drifted after storm-08-20. walker_health measures wall-clock
         so the mismatch looked like a 55.9h stale wound on 2026-08-29
         even though launchctl thought it was on schedule.
         RunAtLoad=true belt-and-suspenders: catches missed slots when
         the Wed 08:00 fire lands during a FileVault loginwindow gap
         (storm-08-20 class). Weekly + additive + ~5min = no harm from
         occasional double-run after a boot. -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/enrich_token_names.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/enrich_token_names.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
