<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.verify_toml</string>

    <key>Comment</key>
    <string>Weekly first-party identity scanner: discover new XRPL accounts via xrp-ledger.toml.</string>

    <!-- Wrapper sources ~/.config/xrpldashboard/env before invoking
         python. Calling python directly leaves DATABASE_URL unset —
         both walker_health writes AND the account_labels dual-writes
         silently no-op. Same latent bug as lending_snapshot; caught by
         plist sweep 2026-07-08. See run_verify_toml.sh. -->
    <key>ProgramArguments</key>
    <array>
      <string>/Users/charliebruce/xrpl_test/launchd/run_verify_toml.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <!-- Weekly: every 7 days = 604800 seconds. Light enough to run on schedule
         even if the Mac was asleep — RunAtLoad covers post-reboot catch-up. -->
    <key>StartInterval</key>
    <integer>604800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/verify_toml.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/verify_toml.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
