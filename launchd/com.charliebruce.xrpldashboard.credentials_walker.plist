<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.credentials_walker</string>

    <key>Comment</key>
    <string>One-shot /credentials walker. Replaces the in-gunicorn-worker daemon pattern in credentials_state._refresh_loop with a launchd-triggered runner mirroring mpt_snapshot. Each run: refreshes XLS-70 amendment status, walks account_objects type=credential across the persisted seed set (auto-expanding via newly-discovered issuers/subjects), scans recent validated ledgers for CredentialCreate/Accept/Delete txs, and writes a single snapshot to Neon. The /credentials route reads from PG only; Render no longer runs a walker.</string>

    <!-- Wrapper sources ~/.config/xrpldashboard/env so DATABASE_URL is
         present at launch; without it db.write_credentials_snapshot
         silently no-ops and Render keeps reading stale PG. Same pattern
         as run_mpt_snapshot.sh + run_daily_snapshot.sh. -->
    <key>ProgramArguments</key>
    <array>
      <string>/Users/charliebruce/xrpl_test/launchd/run_credentials_walker.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <!-- Every 30 minutes. Each pass budgets ~5 min for the seed-walk
         + ~3 min for recent-activity scan, so worst-case the run finishes
         in ~8 min and idles for ~22. Matches the prior daemon's 30-min
         refresh defaults (CREDENTIALS_CUM_REFRESH, CREDENTIALS_RECENT_REFRESH). -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/credentials_walker.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/credentials_walker.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
