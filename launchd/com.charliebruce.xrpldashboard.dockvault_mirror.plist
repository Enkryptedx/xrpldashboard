<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>Nightly local mirror of ~/xrpl_test + ~/.ssh to /Volumes/DockVault/xrpl_mirror. 04:00 EDT — 1h after b2_backup at 03:00 to avoid contention. Cloud-independent recovery: if Backblaze is unreachable, restore from dock. Uses rclone sync (single-copy semantics; B2 holds versioned history). RunAtLoad FALSE: don't sync on every login. Loud-skip if DockVault not mounted or launchd context lacks FDA (per 2026-08-23 revival doctrine).</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.charliebruce.xrpldashboard.dockvault_mirror</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/charliebruce/xrpl_test/launchd/run_dockvault_mirror.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/charliebruce/xrpl_test/launchd_logs/dockvault_mirror.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/charliebruce/xrpl_test/launchd_logs/dockvault_mirror.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/charliebruce/xrpl_test</string>
</dict>
</plist>
