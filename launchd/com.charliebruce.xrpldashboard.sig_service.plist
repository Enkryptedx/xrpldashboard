<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>Receipt-signing service — Ed25519 signer for /check.json response envelopes. Runs on 127.0.0.1:8842. Cloudflare Tunnel routes sig.xrpldashboard.com → this. Service starts LOCKED; Charlie unlocks after each restart via localhost POST /unlock, passphrase on paper only (never env / Keychain). See docs/SIG_SERVICE.md.</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.charliebruce.xrpldashboard.sig_service</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/charliebruce/xrpl_test/launchd/run_sig_service.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardErrorPath</key>
	<string>/Users/charliebruce/xrpl_test/launchd_logs/sig_service.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/charliebruce/xrpl_test/launchd_logs/sig_service.out.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/charliebruce/xrpl_test</string>
</dict>
</plist>
