<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.mcp_ua_matrix_canary</string>

    <key>Comment</key>
    <string>MCP UA-matrix regression canary: daily 16-UA probe against mcp.xrpldashboard.com/health. Alarms if the CF WAF skip rule leaked and any UA sees the 1010 "browser signature banned" body. Result lands in walker_health as mcp_ua_matrix_canary.</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/charliebruce/xrpl_test/launchd/run_mcp_ua_matrix_canary.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/mcp_ua_matrix_canary.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/mcp_ua_matrix_canary.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
