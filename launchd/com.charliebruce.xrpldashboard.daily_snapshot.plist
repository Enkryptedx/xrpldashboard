<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.daily_snapshot</string>

    <key>Comment</key>
    <string>Daily historical snapshot: watchlist account balances + top 200 AMM pool reserves at a validated ledger. Output: historical_snapshots/YYYY-MM-DD.json.</string>

    <!-- Wrapper script sources DATABASE_URL from ~/.config/xrpldashboard/env
         before exec'ing python, so db.write_snapshot_meta() mirrors the
         rollup into Neon Postgres. Without this, the disk file lands but
         /institutional (served by Render off Neon) keeps showing the
         previous meta row — the strip drifts silently. -->
    <key>ProgramArguments</key>
    <array>
      <string>/Users/charliebruce/xrpl_test/launchd/run_daily_snapshot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <!-- 24-hour rolling interval, not a fixed wall-clock time. Was
         StartCalendarInterval Hour=2 Minute=7 (off-peak) until 2026-05-13:
         macOS UserEventAgent-Aqua dispatches calendar triggers
         unreliably across sleep/wake/powernap — we observed the 02:07
         armed trigger sit through the night and never fire. StartInterval
         survives sleep/wake cleanly (catches up on resume). RunAtLoad
         covers install-time + post-reboot catch-up. -->
    <key>StartInterval</key>
    <integer>86400</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/daily_snapshot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/daily_snapshot.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
