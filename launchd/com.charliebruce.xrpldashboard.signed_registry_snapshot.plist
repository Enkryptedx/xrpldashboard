<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>Daily signed XRPL Token Registry snapshot. Fires 02:15 UTC (75 min after signed_snapshot). Signs via the sig-service (kind=registry); writes signed_registry_snapshots/YYYY-MM-DD.json; Flask serves at /.well-known/registry/&lt;date&gt;.json. Fails cleanly if sig-service is locked or Postgres unavailable — the daily anchored snapshot still commits registry_state either way.</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.charliebruce.xrpldashboard.signed_registry_snapshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/charliebruce/xrpl_test/launchd/run_signed_registry_snapshot.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/Users/charliebruce/xrpl_test/launchd_logs/signed_registry_snapshot.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/charliebruce/xrpl_test/launchd_logs/signed_registry_snapshot.out.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/charliebruce/xrpl_test</string>
</dict>
</plist>
