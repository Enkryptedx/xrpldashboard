<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.mpt_snapshot</string>

    <key>Comment</key>
    <string>MPToken issuance registry snapshot writer. Walks every MPTokenIssuance ledger object (full ledger walk — ledger_data with a type filter still paginates through tens of millions of entries), decodes XLS-89 metadata, enriches top-N by outstanding supply with holder counts via mpt_holders, mirrors to Postgres for Render. /mpts route reads this file when fresh (&lt;26hr); falls back to PG and then to in-process fetcher. Daily cadence because a complete mainnet walk takes 1-5 hours. At end of run, persists mpt_issuance_list.json for the hourly mpt_holders_refresh job.</string>

    <!-- Wrapper sources ~/.config/xrpldashboard/env so DATABASE_URL is
         present at launch; without it db.write_mpt_snapshot +
         write_mpt_supply_history silently no-op on every scheduled run
         and Render keeps reading stale numbers. Same pattern as
         run_daily_snapshot.sh + run_mpt_holders_refresh.sh. -->
    <key>ProgramArguments</key>
    <array>
      <string>/Users/charliebruce/xrpl_test/launchd/run_mpt_snapshot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <!-- Daily. A complete mainnet walk now takes 1-5 hours (was bounded
         at 10 min and gave a misleading count). MPT issuance counts move
         on a days-to-weeks timescale today, so daily is plenty. -->
    <key>StartInterval</key>
    <integer>86400</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/mpt_snapshot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/mpt_snapshot.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
