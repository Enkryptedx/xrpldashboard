<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charliebruce.xrpldashboard.mpt_snapshot</string>

    <key>Comment</key>
    <string>MPToken issuance registry snapshot writer. Walks every MPTokenIssuance ledger object, decodes XLS-89 metadata, enriches top-N by outstanding supply with holder counts via mpt_holders, writes mpt_snapshot.json atomically. /mpts route reads this file when fresh (&lt;2hr); falls back to in-process fetcher otherwise. Hourly cadence because a full mainnet ledger walk for sparsely-populated MPT objects can take several minutes.</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
      <string>/Users/charliebruce/xrpl_test/mpt_snapshot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/charliebruce/xrpl_test</string>

    <!-- Every hour. Mainnet MPT walks are minutes-long; 15-min cadence
         would just chain back-to-back walks. Issuance counts shift on
         hours-to-days timescale, not seconds. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/mpt_snapshot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliebruce/xrpl_test/launchd_logs/mpt_snapshot.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
