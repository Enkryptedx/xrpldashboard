# xrpldashboard environment configuration — template.
#
# Copy to .env, then fill in real values. Never commit .env.
# Only variables the app or walkers actually read are listed here;
# tuning knobs (cache TTLs, page limits, etc.) have sensible defaults
# and are documented at their point-of-use in the code.

# ── Core (required for the web app to boot against Postgres) ─────────

# Postgres connection string. Neon-hosted in production; any Postgres
# 14+ works for local dev. Web app degrades gracefully to SQLite when
# unset (see db.py for the dual-read policy).
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Optional: direct (unpooled) Postgres endpoint for writers. On Neon,
# use the un-pooled endpoint here to avoid pooler-related write
# stalls. Falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=

# Flask session-cookie signing key. Stable across deploys is preferred
# (otherwise sessions invalidate on restart); a random value is
# generated per-boot if unset.
FLASK_SECRET_KEY=

# Canonical site URL used for absolute links and OG tags.
SITE_URL=https://xrpldashboard.com

# ── Ingest / walker fleet (required for XRPL data ingestion) ────────

# Primary public XRPL node used by most walkers.
XRPL_NODE=https://s1.ripple.com:51234

# Local rippled node, tried first by the xrpl_client cascade.
# Falls back to XRPL_PUBLIC_PRIMARY / SECONDARY on failure.
XRPL_LOCAL_NODE=http://localhost:5005
XRPL_PUBLIC_PRIMARY=https://s1.ripple.com:51234
XRPL_PUBLIC_SECONDARY=https://s2.ripple.com:51234

# Clio node for account_lines-heavy queries.
XRPL_CLIO_NODE=https://s2.ripple.com:51234

# Ethereum RPC (Alchemy-style keyed endpoint recommended) used by
# the RLUSD cross-check walker. Keyless fallbacks are hardcoded in
# cross_check_walker.py; setting this prepends a reliable endpoint.
ETH_RPC=

# Etherscan API key for RLUSD ETH mint/burn calendar-day walk.
ETHERSCAN_API_KEY=

# ── Signed-snapshot signing (required to generate daily snapshots) ──

# Passphrase for the Ed25519 signing key (PEM-encoded, AES-256 wrapped).
# Signing key path is fixed in signed_snapshot.py; passphrase is the
# only secret. Prompted interactively if unset and stdin is a TTY.
SIGNING_KEY_PASSPHRASE=

# ── Contact form email (optional — form logs to DB regardless) ──────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ── Internal admin (optional — protects /admin_stats) ───────────────

INTERNAL_ADMIN_USER=
INTERNAL_ADMIN_PASS=

# ── Backup infrastructure (optional — pg_backup + restore_test) ─────

# rclone remote name and bucket-name PIN for pg_dump uploads. Both the
# writer (launchd/run_pg_backup.sh) and the reader (tools/restore_test.py)
# read these same names, so pinning here binds both sides. Without the
# PREFIX pin, each side derives the bucket from hostname, which under
# launchd has been observed to return different short-names on different
# runs — leading to writer/reader drift (see 2026-08-22 diagnosis).
BACKUP_REMOTE=b2crypt
BACKUP_BUCKET_PREFIX=

# ── Analytics tuning (optional) ─────────────────────────────────────

# Comma-separated IPs to exclude from page-view analytics
# (e.g., the author's home IP to keep counts honest).
ANALYTICS_EXCLUDE_IPS=

# ── Flask runtime (optional — defaults are sensible) ────────────────

PORT=5001
FLASK_DEBUG=0
